<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExpressApp.MainPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout
            Spacing="20"
            Padding="30"
            VerticalOptions="Center">

            <Label
                Text="eXpress"
                Style="{StaticResource Headline}"
                HorizontalOptions="Center" />

            <Label
                x:Name="StatusLabel"
                Text="Инициализация модуля авторизации..."
                TextColor="{StaticResource Primary}"
                HorizontalOptions="Center"
                FontSize="Medium" />

            <!-- Блок данных QR-кода -->
            <Border
                x:Name="QrDataBorder"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="1"
                Stroke="{StaticResource Secondary}"
                Background="{StaticResource Gray100}"
                IsVisible="False"
                Padding="16">

                <VerticalStackLayout Spacing="8">
                    <Label Text="Данные QR-кода:" FontAttributes="Bold" TextColor="{StaticResource Gray950}" />
                    <Label x:Name="QrPayloadLabel" Text="" TextColor="{StaticResource Gray950}" FontSize="Small" LineBreakMode="WordWrap" />
                    <Label x:Name="QrRequestIdLabel" Text="" TextColor="{StaticResource Gray600}" FontSize="Small" />
                    <Label x:Name="QrExpiresLabel" Text="" TextColor="{StaticResource Gray600}" FontSize="Small" />
                </VerticalStackLayout>
            </Border>

            <!-- ASCII-превью QR для отладки -->
            <Border
                x:Name="QrPreviewBorder"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="1"
                Stroke="{StaticResource Tertiary}"
                Background="{StaticResource Gray950}"
                IsVisible="False"
                Padding="8">

                <Label
                    x:Name="QrPreviewLabel"
                    Text=""
                    TextColor="Green"
                    FontFamily="OpenSansRegular"
                    FontSize="Micro"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <Button
                x:Name="StartQrButton"
                Text="Запросить QR-код"
                Clicked="OnStartQrClicked"
                HorizontalOptions="Center"
                Margin="0,20,0,0" />

            <Button
                x:Name="ResetButton"
                Text="Сбросить авторизацию"
                Clicked="OnResetClicked"
                HorizontalOptions="Center"
                BackgroundColor="{StaticResource Gray300}"
                TextColor="{StaticResource Gray950}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
